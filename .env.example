# ==========================================
# BASE BLOCKCHAIN CONFIGURATION
# ==========================================
# Base Sepolia Testnet RPC (Default is public endpoint)
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_MAINNET_RPC_URL="https://mainnet.base.org"

# Chain ID: 84532 for Base Sepolia, 8453 for Base Mainnet
NEXT_PUBLIC_BASE_CHAIN_ID="84532"
NEXT_PUBLIC_BASE_RPC_URL="https://sepolia.base.org"
NEXT_PUBLIC_BASE_EXPLORER_URL="https://sepolia.basescan.org"

# Deployed FaceMediaRegistry Contract Address on Base
NEXT_PUBLIC_CONTRACT_ADDRESS="0x94B73E7E59F9F0E1A4a15993214D162351952eA6"

# Server Relayer Private Key (for automatic server-side on-chain attestation if user wallet is not connected)
# Note: For production or testnet recording, add 0x prefixed private key with Base Sepolia ETH
PRIVATE_KEY=""

# BaseScan API Key (optional, for contract verification)
BASESCAN_API_KEY=""

# ==========================================
# OSINT & SEARCH CONFIGURATION
# ==========================================
# Optional: SerpApi Key for live Google Lens / Reverse Search
SERPAPI_API_KEY=""

# Application Port
PORT=3000
